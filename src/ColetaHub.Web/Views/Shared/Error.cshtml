@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<section class="pagina-erro">
    <div class="pagina-erro__icone pagina-erro__icone--erro"><i class="bi bi-cone-striped" aria-hidden="true"></i></div>
    <p class="pagina-erro__codigo">Ops</p>
    <h1 class="pagina-erro__titulo">Algo deu errado por aqui</h1>
    <p class="pagina-erro__texto">
        Não foi possível concluir a operação. Tente novamente em instantes; se o problema continuar,
        informe o código abaixo para a equipe de suporte.
    </p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="pagina-erro__id">Código da requisição: <code>@Model.RequestId</code></p>
    }
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house" aria-hidden="true"></i> Voltar ao início</a>
        <a class="btn btn-outline-secondary" asp-controller="Pacotes" asp-action="Index">Ver pacotes</a>
    </div>
</section>
